<ContentPage
    x:Class="Horoscope.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard">

    <Grid x:Name="Root"
            Padding="24"
            RowDefinitions="Auto,Auto,*,Auto"
            Opacity="0">
        <Label Text="Dashboard"
                FontSize="24"/>
        <Label x:Name="SignedInAsLabel"
                Grid.Row="1"
                FontSize="14"
                TextColor="Gray"/>

        <ActivityIndicator x:Name="Busy"
                           Grid.Row="2"
                           IsRunning="True"
                           IsVisible="True"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

        <Button Grid.Row="3"
                Text="Sign Out"
                Clicked="OnSignOutClicked"/>
    </Grid>
</ContentPage>
