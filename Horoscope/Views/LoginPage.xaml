<ContentPage
    x:Class="Horoscope.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login">

    <Grid RowDefinitions="Auto,*">
        <!-- tap to dismiss keyboard -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped"/>
        </Grid.GestureRecognizers>

        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Welcome" FontSize="24" HorizontalOptions="Center" />

            <Entry x:Name="EmailEntry"
                   Placeholder="Email"
                   Keyboard="Email"
                   ReturnType="Next" />

            <Entry x:Name="PasswordEntry"
                   Placeholder="Password"
                   IsPassword="True"
                   ReturnType="Go"
                   Completed="OnPasswordCompleted" />

            <Button x:Name="SignInButton"
                    Text="Sign In"
                    Clicked="OnSignInClicked" />

            <Button x:Name="SignUpButton"
                    Text="Create Account"
                    Clicked="OnSignUpClicked" />

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False" />

            <Label x:Name="ErrorLabel"
                   TextColor="Red"
                   IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
